# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DB_PATH=./database/podcast_qa.db

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Secrets
JWT_SECRET=podcast_qa_jwt_secret_key_2026
REFRESH_SECRET=podcast_qa_refresh_secret_2026

# AI Provider (gemini | openai)
AI_PROVIDER=gemini
AI_API_KEY=your_google_ai_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

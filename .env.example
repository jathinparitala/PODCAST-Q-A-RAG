# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DB_PATH=./database/podcast_qa.db

# Frontend Client URL (for backend CORS)
CLIENT_URL=http://localhost:5173

# Backend API URL (for frontend VITE_API_URL configuration in production)
VITE_API_URL=http://localhost:5000/api

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
REFRESH_SECRET=your_refresh_secret_key_here

# AI Provider (gemini | openai)
AI_PROVIDER=gemini
AI_API_KEY=your_google_ai_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30


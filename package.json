{
  "name": "podcast-transcript-qa-rag",
  "version": "1.0.0",
  "description": "AI-powered Podcast Transcript & PDF Q&A with Retrieval-Augmented Generation",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "install:all": "npm install",
    "build": "npm run build --workspace=client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
